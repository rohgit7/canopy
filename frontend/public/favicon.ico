<svg version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 2000 2000">
  <defs>
    <clipPath id="circleClip">
      <circle cx="1000" cy="1000" r="980"/>
    </clipPath>
  </defs>
  <g clip-path="url(#circleClip)">
    <rect width="2000" height="2000" fill="#0f1b2a"/>
    <circle cx="1000" cy="1000" r="980" fill="#161e2e" stroke="#ff9900" stroke-width="40"/>
    <image href="/canopy-logo.svg" x="100" y="100" width="1800" height="1800" />
  </g>
</svg>
